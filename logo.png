.hero .logo {
  width: 120px;
  height: 120px;
  margin-bottom: 12px;
}
.hero .logo {
  width: 150px;
  height: 150px;
  margin: 0 auto 15px;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;
  z-index: 2;

  animation: logoFloat 4s ease-in-out infinite;

  filter:
    drop-shadow(0 0 8px #ffd700)
    drop-shadow(0 0 22px rgba(255, 215, 0, 0.8));
}

.hero .logo svg {
  width: 100%;
  height: 100%;
  display: block;
}

@keyframes logoFloat {

  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-7px);
  }

}
